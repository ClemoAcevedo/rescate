# Copiar endpoint y región del bucket privado B2, sin /bucket al final.
PHOTO_S3_ENDPOINT=
PHOTO_S3_REGION=
PHOTO_S3_BUCKET=
# keyID y applicationKey de una application key limitada al bucket de prueba.
PHOTO_S3_ACCESS_KEY_ID=
PHOTO_S3_SECRET_ACCESS_KEY=
