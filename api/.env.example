# Base de datos

# Ejemplo ficticio para desarrollo local.
# Los scripts db:* cargan api/.env; una variable exportada tiene prioridad.
DATABASE_URL=postgresql://rescate_example:example_password@localhost:5432/rescate_k002_test


# Autenticación K008: orígenes HTTPS exactos (esquema, host, puerto), separados por coma.
RESCATE_ALLOWED_ORIGINS=https://localhost:3443
# Generar una clave propia con: openssl rand -base64 32
# Guardarla fuera de Git y conservarla al reiniciar. Sin default en la API.
CSRF_SIGNING_KEY=


# Almacenamiento de fotos

# Solo utilizado por el proceso Node. Nunca exponer estas variables con prefijo VITE_.
PHOTO_LOCAL_DIR=.k005-storage

# Configuración S3 compatible para el bucket privado.
PHOTO_S3_ENDPOINT=
PHOTO_S3_REGION=
PHOTO_S3_BUCKET=

# Credenciales de una application key limitada al bucket.
PHOTO_S3_ACCESS_KEY_ID=
PHOTO_S3_SECRET_ACCESS_KEY=
# HTTPS directo opcional. Ambos archivos deben estar fuera de Git.
# Sin ellos, HTTP interno debe quedar detrás de un proxy HTTPS del mismo origen.
TLS_CERT_FILE=
TLS_KEY_FILE=
