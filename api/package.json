{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "photos": "node --env-file-if-exists=.env dist/prototypes/photos/cli.js",
    "test:photos": "npm run build && node --test test/photos.test.mjs",
    "typecheck": "tsc --noEmit",
    "api:contract:check": "REDOCLY_TELEMETRY=off redocly lint ../docs/api/openapi.yaml --config ../docs/api/redocly.yaml --lint-config error",
    "test": "node --import tsx --test test/*.test.ts",
    "worker": "tsx src/worker.ts",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "db:create": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js create --migration-file-language sql",
    "db:rollback": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down 1",
    "db:test": "node --env-file-if-exists=.env scripts/test-migrations.mjs",
    "db:test:compose": "node scripts/test-migrations-compose.mjs",
    "db:test:lots": "npm run build && node --env-file-if-exists=.env scripts/test-lots.mjs",
    "db:test:lots:compose": "node scripts/test-lots-compose.mjs",
    "db:test:identity": "npm run build && node --env-file-if-exists=.env scripts/test-identity.mjs",
    "db:test:identity:compose": "node scripts/test-identity-compose.mjs",
    "crypto:benchmark": "node scripts/benchmark-scrypt.mjs",
    "api:types": "node scripts/generate-http-types.mjs",
    "api:types:check": "node scripts/generate-http-types.mjs --check",
    "db:test:auth": "npm run build && node --import tsx --env-file-if-exists=.env scripts/test-auth.mjs",
    "db:test:auth:compose": "node scripts/test-auth-compose.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "express": "^5.2.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@redocly/cli": "2.53.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "node-pg-migrate": "9.0.0",
    "playwright": "1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
