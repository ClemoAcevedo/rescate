# URL base para desarrollo: Vite reenvía /api al backend local en el puerto 3000.
# No incluir secretos en este archivo.
VITE_API_BASE_URL=/api

# Solo desarrollo: activa respuestas controladas de identidad. No usar en producción.
# Valores: success, validation, credentials, network, forbidden, logout-failure.
# VITE_AUTH_MOCK_SCENARIO=success
# VITE_AUTH_MOCK_DELAY_MS=450
